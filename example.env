# Copy this file to .env. Never commit the resulting .env file.

# Application
NODE_ENV=development
PORT=3000

# Database
DATABASE_URL=postgres://username:password@localhost:5432/marketplace

# Authentication
JWT_SECRET=replace-with-a-long-random-secret
JWT_ACCESS_TOKEN_TTL=15m
JWT_REFRESH_TOKEN_TTL=7d

# SMS
# Development uses MockSmsProvider when NODE_ENV=development.
# Twilio settings are required when the real TwilioSmsProvider is selected.
SMS_PROVIDER=mock
TWILIO_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_TOKEN=replace-with-your-twilio-auth-token
TWILIO_FROM=+15555550123
